# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=8080

# Frontend address(es) allowed to call this API (comma-separated). Empty = allow all.
FRONTEND_URL=https://app.example.com

# MySQL (overrides config.json when set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=a1mart
DB_PASSWORD=change-me
DB_NAME=a1mart

# Third-party APIs (read-only syncs)
GOFRUGAL_API_KEY=
DELIUM_API_KEY=
DELIUM_BASE_URL=https://ayyappanplasticmarket.delium.io
DIGISME_API_KEY=
DIGISME_CUSTOM_KEY=

# AWS S3 uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=a1-stores-bucket

# JWT RS256 keys — either files keys/jwt/private.key + public.key, or PEM here
# (generate: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Database setup (npm run db:setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Demo data on start (keep false on a live database)
SEED_SAMPLE_DATA=false
