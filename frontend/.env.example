# Copy to .env.local (development) or set in your hosting dashboard (production).
# Backend API base URL — must end with a slash.
NEXT_PUBLIC_API_URL=http://localhost:8080/
NEXT_PUBLIC_IS_PROD=true
# Show the /dev/sample-data page in a production build (normally leave unset)
# NEXT_PUBLIC_ENABLE_SAMPLE_DATA=true
